        "MOONRAND_ENABLE_BENCH": "ON",
        "MOONRAND_ENABLE_PERF_COUNTERS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz",
      "inherits": "debug",
      "cacheVariables": {
        "MOONRAND_ENABLE_FUZZ": "ON"
      }
    },
    {
      "name": "slowtests",
      "displayName": "SlowTests",
