{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "environment": {
        "PATH": "D:/Program Files/JetBrains/CLion 2025.3.1/bin/mingw/bin;D:/Program Files/JetBrains/CLion 2025.3.1/bin/ninja/win/x64;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "D:/Program Files/JetBrains/CLion 2025.3.1/bin/mingw/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/Program Files/JetBrains/CLion 2025.3.1/bin/mingw/bin/g++.exe"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
